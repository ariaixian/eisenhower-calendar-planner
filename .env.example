# Generate a long random value for local use. Never commit the real value.
FLASK_SECRET_KEY=replace-with-a-random-secret

# Local OAuth callback. Production must use an HTTPS redirect URI.
REDIRECT_URI=http://localhost:5000/oauth2callback

# Complete Google OAuth client JSON as a single-line environment value.
# Never place a real client ID or secret in this example file.
GOOGLE_OAUTH_JSON={"web":{"client_id":"example.apps.googleusercontent.com","client_secret":"replace-me","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","redirect_uris":["http://localhost:5000/oauth2callback"]}}
